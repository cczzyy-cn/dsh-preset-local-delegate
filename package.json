{
  "name": "dsh-preset-local-delegate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH agent preset: the shipped `standard` preset verbatim, plus gated delegation to a local tool model.",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node local-delegate.selftest.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "ledger": "node scripts/ledger.mjs",
    "trace": "node scripts/subagent-trace.mjs",
    "sync": "node scripts/sync-install.mjs",
    "sync:check": "node scripts/sync-install.mjs --check",
    "gen": "python tools/build-local-delegate-preset.py",
    "gen:check": "python tools/build-local-delegate-preset.py --check",
    "gen:selftest": "python tools/build-local-delegate-preset.py --selftest",
    "validate": "python tools/validate-preset-bundle.py .",
    "roster": "python tools/check-profile-roster.py"
  },
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./local-delegate.mjs": "./local-delegate.mjs"
  },
  "files": [
    "cordis.patch.yml",
    "engine-profile.json",
    "*.mjs",
    "README*.md",
    "scripts/"
  ]
}
